// ── Touch-hold WiFi reset at boot ───────────────────────────────────────────
// Shows a splash for WIFI_RESET_WINDOW_MS; returns true if the screen is held
// for WIFI_RESET_HOLD_MS, with a progress bar while it's held.
bool wifiResetRequested() {
  const int barX = 100, barY = SCREEN_H - 60, barW = SCREEN_W - 200, barH = 24;
  uint32_t start = millis(), heldSince = 0;
  while (true) {
    uint32_t now = millis();
    bool touched = display.touched();
    if (touched && heldSince == 0) heldSince = now;
    if (!touched) heldSince = 0;
    uint32_t held = touched ? now - heldSince : 0;

    drawStatus("Color Clock", "Touch & hold to reset WiFi", TFT_CYAN);
    if (touched) {
      spr.drawRect(barX - 2, barY - 2, barW + 4, barH + 4, TFT_WHITE);
      spr.fillRect(barX, barY, min<uint32_t>(held, WIFI_RESET_HOLD_MS) * barW / WIFI_RESET_HOLD_MS,
                   barH, TFT_RED);
    }
    presentFrame();   // paced by the panel's frame rate

    if (touched && held >= WIFI_RESET_HOLD_MS) return true;
    if (!touched && now - start >= WIFI_RESET_WINDOW_MS) return false;
  }
}

// ── Touch (polled once per loop pass) ───────────────────────────────────────
struct TouchState {
  bool down    = false;   // finger on the screen
  bool started = false;   // went down this pass
  int  x = 0, y = 0;      // last position while down
} touch;

void pollTouch() {
  int x, y;
  bool down = display.touchPoint(x, y);
  touch.started = down && !touch.down;
  touch.down = down;
  if (down) { touch.x = x; touch.y = y; }
  if (touch.started) Serial.printf("Touch at %d,%d\n", x, y);
}

// ── Dim / off schedules ─────────────────────────────────────────────────────
// start..end in minutes after midnight; may span midnight; equal = never.
bool inWindow(bool enabled, uint16_t start, uint16_t end, const struct tm& ti) {
  if (!enabled || start == end) return false;
  int now = ti.tm_hour * 60 + ti.tm_min;
  if (start < end) return now >= start && now < end;
  return now >= start || now < end;
}

Schedule scheduleAt(const struct tm& ti) {
  if (inWindow(settings.off_enabled, settings.off_start, settings.off_end, ti)) return SCHED_OFF;
  if (inWindow(settings.dim_enabled, settings.dim_start, settings.dim_end, ti)) return SCHED_DIM;
  return SCHED_NORMAL;
}

uint8_t  backlightLevel = 0;   // percent last sent to the backlight
uint8_t  wakeLevel = 0;        // level a tap raised the screen to
uint32_t wakeUntil = 0;        // millis() deadline of that tap-to-wake; 0 = none

void setBacklightLevel(uint8_t level, const char* why) {
  if (level == backlightLevel) return;   // on the Advance each change is an I2C write
  backlightLevel = level;
  display.setBrightness(level);
  Serial.printf("Backlight %u%% (%s)\n", level, why);
}

// Normal brightness, or the dim level / off per schedule. While dim or off a
// tap brightens one step for wake_s (off → dim level, dim → normal), re-armed
// while touching. Frames keep rendering while off, so the clock is current the
// moment the screen comes on. Returns true if this pass's tap was used to wake.
bool updateScreenPower(const struct tm& ti) {
  Schedule sched = scheduleAt(ti);
  uint8_t dimLevel  = min(settings.dim_level, settings.brightness);
  uint8_t scheduled = sched == SCHED_OFF ? 0 : sched == SCHED_DIM ? dimLevel : settings.brightness;

  if (wakeUntil && (int32_t)(millis() - wakeUntil) >= 0) wakeUntil = 0;
  uint8_t level = wakeUntil ? max(wakeLevel, scheduled) : scheduled;

  bool woke = false;
  if (touch.started && level < settings.brightness) {
    wakeLevel = level == 0 ? dimLevel : settings.brightness;
    level = wakeLevel;
    woke = true;
  }
  if (wakeUntil || woke) {
    if (touch.down) wakeUntil = (millis() + settings.wake_s * 1000UL) | 1;
  }
  setBacklightLevel(level, wakeUntil ? "tapped" : sched == SCHED_OFF ? "off schedule"
                         : sched == SCHED_DIM ? "dim schedule" : "normal");
  return woke;
}

// ── Hourly chime (boards with a buzzer) ─────────────────────────────────────
// Two short beeps, stepped from loop() so drawing isn't held up.
#define CHIME_BEEP_MS 120
uint8_t  chimeStep = 0;       // counts down: odd = beeping, even = gap, 0 = idle
uint32_t chimeNext = 0;       // millis() of the next step

void startChime() {
  if (!CrowPanel7::hasBuzzer()) return;
  chimeStep = 4;
  chimeNext = millis();
}

void updateChime() {
  if (!chimeStep || (int32_t)(millis() - chimeNext) < 0) return;
  chimeStep--;
  display.setBuzzer(chimeStep & 1);   // steps 3, 1 = on; 2, 0 = off
  chimeNext = millis() + CHIME_BEEP_MS;
}

// Chimes once at the top of each hour, unless the screen is scheduled dim / off. Only in
// the hour's first seconds, so a boot or settings save at hh:00:30 stays quiet.
void checkHourlyChime(const struct tm& ti) {
  static int lastChimeHour = -1;
  if (ti.tm_min != 0 || ti.tm_sec >= 10 || ti.tm_hour == lastChimeHour) return;
  lastChimeHour = ti.tm_hour;
  if (settings.chime && scheduleAt(ti) == SCHED_NORMAL) startChime();
}

