// ── Web handlers ────────────────────────────────────────────────────────────
String uptimeString() {
  long s = millis() / 1000;
  char buf[32];
  snprintf(buf, sizeof(buf), "%ldd %02ld:%02ld:%02ld",
           s/86400, (s%86400)/3600, (s%3600)/60, s%60);
  return String(buf);
}

void handleRoot() {
  String html = FPSTR(SETTINGS_HTML);
  html.replace("%MDNS%",   MDNS_NAME);
  html.replace("%IP%",     WiFi.localIP().toString());
  html.replace("%RSSI%",   wifiOnline ? String(WiFi.RSSI()) + " dBm" : "offline");
  html.replace("%UPTIME%", uptimeString());
  html.replace("%NTP%",    settings.ntp_server);
  html.replace("%TZ%",     settings.tz_string);
  html.replace("%FMT24%",  settings.format_24h   ? "checked" : "");
  html.replace("%SECS%",   settings.show_seconds ? "checked" : "");
  html.replace("%DATE%",   settings.show_date    ? "checked" : "");
  html.replace("%GAMMA%",  String(settings.gamma, 1));
  html.replace("%DIM%",    settings.dim_enabled ? "checked" : "");
  html.replace("%DSTART%", hhmm(settings.dim_start));
  html.replace("%DEND%",   hhmm(settings.dim_end));
  html.replace("%DLEVEL%", String(settings.dim_level));
  html.replace("%OFF%",    settings.off_enabled ? "checked" : "");
  html.replace("%OSTART%", hhmm(settings.off_start));
  html.replace("%OEND%",   hhmm(settings.off_end));
  html.replace("%WAKE%",   String(settings.wake_s));
  html.replace("%BRIGHT%", String(settings.brightness));
  html.replace("%CHIME%",  settings.chime ? "checked" : "");
  html.replace("%CHIMESTYLE%", CrowPanel7::hasBuzzer() ? "" : "style=\"display:none\"");
  html.replace("%SCREEN%", backlightLevel == 0 ? String("Off (scheduled)")
                         : String(backlightLevel) + "%" + (wakeUntil ? " (tapped)"
                         : backlightLevel < settings.brightness ? " (dimmed)" : ""));
  server.send(200, "text/html", html);
}

void handleSave() {
  if (server.hasArg("ntp")) settings.ntp_server = server.arg("ntp");
  if (server.hasArg("tz"))  settings.tz_string  = server.arg("tz");
  settings.format_24h   = server.hasArg("fmt24");
  settings.show_seconds = server.hasArg("secs");
  settings.show_date    = server.hasArg("date");
  if (server.hasArg("gamma")) {
    settings.gamma = constrain(server.arg("gamma").toFloat(), MIN_GAMMA, MAX_GAMMA);
    buildGammaLut();
  }
  if (server.hasArg("bright")) settings.brightness = constrain(server.arg("bright").toInt(), 5, 100);
  int t;
  settings.dim_enabled = server.hasArg("dim");
  if ((t = parseHHMM(server.arg("dstart"))) >= 0) settings.dim_start = t;
  if ((t = parseHHMM(server.arg("dend")))   >= 0) settings.dim_end   = t;
  if (server.hasArg("dlevel")) settings.dim_level = constrain(server.arg("dlevel").toInt(), 5, 100);
  settings.off_enabled = server.hasArg("off");
  if ((t = parseHHMM(server.arg("ostart"))) >= 0) settings.off_start = t;
  if ((t = parseHHMM(server.arg("oend")))   >= 0) settings.off_end   = t;
  if (server.hasArg("wake")) settings.wake_s = constrain(server.arg("wake").toInt(), 5, 3600);
  settings.chime = server.hasArg("chime");
  saveSettings();
  applyTimeSettings();
  logSettings("Saved");
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleTime() {
  struct tm ti;
  if (!getLocalTime(&ti, 50)) { server.send(200, "text/plain", "--:--:--"); return; }
  server.send(200, "text/plain", formatTime(ti));
}

void handleResetWiFi() {
  server.send(200, "text/html",
    "<meta http-equiv='refresh' content='3'>"
    "<body style='font-family:sans-serif;background:#111;color:#eee;padding:30px'>"
    "<h1>Resetting WiFi…</h1><p>Device will reboot into setup mode.</p></body>");
  delay(800);
  WiFiManager wm;
  wm.resetSettings();
  delay(500);
  ESP.restart();
}

// Panel tuning (not persisted): /panel?mhz=26.67 sets the pixel clock live and
// reports the measured refresh rate; /panel alone just reports it.
void handlePanel() {
  String msg;
  if (server.hasArg("mhz")) {
    uint32_t hz = (uint32_t)(server.arg("mhz").toFloat() * 1e6f);
    bool ok = hz >= 8000000 && hz <= 40000000 && display.setPixelClock(hz);
    msg += String(ok ? "set pclk " : "rejected pclk ") + server.arg("mhz") + " MHz\n";
    delay(200);   // let the new clock take effect
  }
  msg += "fps=" + String(display.measureFps(), 1) + "\n";
  Serial.print("Panel: " + msg);
  server.send(200, "text/plain", msg);
}

// Diagnostic: /test shows ramps of dark gray/red/green/blue (levels 0-120,
// raw — no gamma) to find which levels the panel visibly dithers. Stays up for
// 5 minutes or until /test?off.
uint32_t testPatternUntil = 0;   // millis() deadline; 0 = clock is showing

void drawTestPattern() {
  const char* rows[] = {"Gray", "Red", "Green", "Blue"};
  const int cols = 16, barW = SCREEN_W / cols, rowH = SCREEN_H / 4;
  spr.fillSprite(TFT_BLACK);
  useFont(fontText24);
  spr.setTextColor(TFT_WHITE);
  for (int r = 0; r < 4; r++) {
    for (int c = 0; c < cols; c++) {
      uint8_t v = c * 8;
      uint16_t col = rgb888to565(r == 0 || r == 1 ? v : 0,
                                 r == 0 || r == 2 ? v : 0,
                                 r == 0 || r == 3 ? v : 0);
      spr.fillRect(c * barW, r * rowH, barW, rowH, col);
      spr.setTextDatum(BC_DATUM);
      spr.drawString(String(v), c * barW + barW/2, r * rowH + rowH - 4);
    }
    spr.setTextDatum(TL_DATUM);
    spr.drawString(rows[r], 4, r * rowH + 4);
  }
  spr.setTextDatum(MC_DATUM);
  presentFrame();
}

void handleTest() {
  if (server.hasArg("off")) {
    testPatternUntil = millis() | 1;   // already expired → loop() restores the clock
    server.send(200, "text/plain", "clock restored\n");
    return;
  }
  drawTestPattern();
  testPatternUntil = (millis() + 300000) | 1;
  server.send(200, "text/plain", "test pattern on for 5 min; /test?off to return\n");
}

// Diagnostic: /snap returns the on-screen framebuffer as raw RGB565 (byte-swapped,
// 800x480). Blocks the loop while sending, so the buffer can't change mid-transfer.
void handleSnap() {
  const uint8_t* fb = (const uint8_t*)display.frontBuffer();
  const size_t len = SCREEN_W * SCREEN_H * 2;
  server.setContentLength(len);
  server.send(200, "application/octet-stream", "");
  for (size_t off = 0; off < len; off += 4096) {
    server.sendContent((const char*)fb + off, min<size_t>(4096, len - off));
  }
}

void handleChime() {
  startChime();
  server.send(204);
}

void handleNotFound() {
  server.send(404, "text/plain", "Not found");
}

void setupWebServer() {
  server.on("/",          handleRoot);
  server.on("/save",      HTTP_POST, handleSave);
  server.on("/time",      handleTime);
  server.on("/reset_wifi",HTTP_POST, handleResetWiFi);
  server.on("/panel",     handlePanel);
  server.on("/test",      handleTest);
  server.on("/snap",      handleSnap);
  server.on("/chime",     HTTP_POST, handleChime);
  server.onNotFound(handleNotFound);
  server.begin();

  if (MDNS.begin(MDNS_NAME)) {
    MDNS.addService("http", "tcp", 80);
    Serial.printf("mDNS: http://%s.local\n", MDNS_NAME);
  }
}

// ── WiFi setup via WiFiManager ──────────────────────────────────────────────
#define WIFI_CONNECT_MS  20000   // boot: wait this long for saved credentials
#define WIFI_RETRY_MS    30000   // offline: reconnect attempt interval

// Boot only. With saved credentials that don't connect in time, the clock runs
// offline if the time is already known (RTC) and loop() keeps retrying. The
// setup portal opens without saved credentials, after a touch-hold reset, or
// when there is no other way to get the time.
void setupWiFi() {
  WiFiManager wm;
  wm.setConfigPortalTimeout(180);
  wm.setAPCallback(portalCallback);
  wm.setDebugOutput(false);

  // Set hostname BEFORE connecting so DHCP advertises it correctly
  WiFi.mode(WIFI_STA);
  WiFi.setHostname(HOSTNAME);

  if (wifiResetRequested()) {
    showStatus("Resetting WiFi", "credentials...", TFT_RED);
    wm.resetSettings();
    delay(1500);
  }

  bool connected = false;
  if (wm.getWiFiIsSaved()) {
    showStatus("Connecting WiFi", "(saved creds)");
    WiFi.begin();
    for (uint32_t start = millis(); millis() - start < WIFI_CONNECT_MS; delay(100)) {
      if (WiFi.status() == WL_CONNECTED) { connected = true; break; }
    }
    if (!connected && timeKnown()) {
      showStatus("WiFi unavailable", "Running offline", TFT_ORANGE);
      delay(2500);
      return;
    }
  }

  if (!connected && !wm.startConfigPortal(AP_NAME, AP_PASSWORD)) {
    WiFi.mode(WIFI_STA);
    if (timeKnown()) {
      showStatus("Setup timeout", "Running offline", TFT_ORANGE);
      delay(2500);
      return;
    }
    showStatus("Setup timeout", "Restarting...", TFT_RED);
    delay(2000);
    ESP.restart();
  }

  wifiOnline = true;
  Serial.printf("WiFi connected: %s\n", WiFi.localIP().toString().c_str());
  showStatus("Connected!", WiFi.localIP().toString(), TFT_GREEN);
  delay(2000);
  showStatus("Web UI at:", String(MDNS_NAME) + ".local", TFT_CYAN);
  delay(2500);
}

// Runs every loop pass: the clock keeps going while WiFi is down, with a
// reconnect attempt every WIFI_RETRY_MS. On reconnect SNTP is restarted, which
// also corrects the RTC.
void checkWiFi() {
  static uint32_t lastTry = 0;
  bool up = WiFi.status() == WL_CONNECTED;
  if (up != wifiOnline) {
    wifiOnline = up;
    lastTry = millis();
    if (up) {
      Serial.printf("WiFi connected: %s\n", WiFi.localIP().toString().c_str());
      applyTimeSettings();
    } else {
      Serial.println("WiFi lost; retrying in the background");
    }
  }
  if (!up && millis() - lastTry >= WIFI_RETRY_MS) {
    lastTry = millis();
    WiFi.reconnect();
  }
}

// ── State ───────────────────────────────────────────────────────────────────
int lastH = -1, lastM = -1, lastS = -1;
bool lastFmt24 = true, lastSecs = true, lastDate = true;  // detect setting changes
float lastGamma = 0;
bool lastOnline = false;

// ── On-screen settings ──────────────────────────────────────────────────────
// Opened by tapping the top-left and top-right corners (either order) within
// CORNER_WINDOW_MS while the screen is at normal brightness. Changes apply
// live; Done, or CONFIG_IDLE_MS without a touch, saves and returns to the clock.
#define CORNER_W          160
#define CORNER_H          120
#define CORNER_WINDOW_MS  5000
#define CONFIG_IDLE_MS    60000
#define REPEAT_DELAY_MS   500     // hold +/- this long to auto-repeat
#define REPEAT_MS         120
#define DIM_PREVIEW_MS    2000    // show the dim level this long after changing it

#define TAB_W     160             // 4 page tabs + Done across the top
#define HEADER_H  80
#define ROWS_Y    100
#define ROW_H     95
#define CTRL_H    64

const char* configTabs[] = {"Clock", "Dim", "Off", "Chime"};
int configPageCount() { return CrowPanel7::hasBuzzer() ? 4 : 3; }

int configRows(int page, ConfigRow* rows) {
  switch (page) {
    case 0:
      rows[0] = {"Brightness",   ROW_PERCENT, &settings.brightness, 5, 100};
      rows[1] = {"24-hour",      ROW_TOGGLE,  &settings.format_24h};
      rows[2] = {"Seconds",      ROW_TOGGLE,  &settings.show_seconds};
      rows[3] = {"Date",         ROW_TOGGLE,  &settings.show_date};
      return 4;
    case 1:
      rows[0] = {"Dim screen",   ROW_TOGGLE,  &settings.dim_enabled};
      rows[1] = {"From",         ROW_TIME,    &settings.dim_start};
      rows[2] = {"Until",        ROW_TIME,    &settings.dim_end};
      rows[3] = {"Brightness",   ROW_PERCENT, &settings.dim_level, 5, 100};
      return 4;
    case 2:
      rows[0] = {"Screen off",   ROW_TOGGLE,  &settings.off_enabled};
      rows[1] = {"From",         ROW_TIME,    &settings.off_start};
      rows[2] = {"Until",        ROW_TIME,    &settings.off_end};
      return 3;
    default:
      rows[0] = {"Hourly chime", ROW_TOGGLE,  &settings.chime};
      rows[1] = {"Test chime",   ROW_ACTION,  nullptr};
      return 2;
  }
}

bool     configOpen = false;
int      configPage = 0;
bool     configDirty = false;     // redraw needed
uint32_t configLastTouch = 0;
uint32_t dimPreviewUntil = 0;     // 0 = no preview
int      heldRow = -1, heldDir = 0;
uint32_t nextRepeat = 0;
uint32_t cornerTapL = 0, cornerTapR = 0;   // millis() of the last tap in each top corner

void openConfig() {
  configOpen = true;
  configPage = 0;
  configDirty = true;
  configLastTouch = millis();
  heldRow = -1;
  Serial.println("On-screen settings opened");
}

void closeConfig() {
  configOpen = false;
  dimPreviewUntil = 0;
  saveSettings();
  logSettings("Saved (on screen)");
  lastS = -1;   // redraw the clock
  // Stay at normal brightness for wake_s, as after a tap, so a dim / off
  // schedule doesn't blank the screen the instant Done is pressed.
  wakeLevel = settings.brightness;
  wakeUntil = (millis() + settings.wake_s * 1000UL) | 1;
}

// A tap in one top corner, then the other within CORNER_WINDOW_MS, opens the settings.
void checkCornerTaps() {
  if (!touch.started || touch.y >= CORNER_H) return;
  uint32_t now = millis(), other;
  if (touch.x < CORNER_W)                  { cornerTapL = now | 1; other = cornerTapR; }
  else if (touch.x >= SCREEN_W - CORNER_W) { cornerTapR = now | 1; other = cornerTapL; }
  else return;
  if (other && now - other <= CORNER_WINDOW_MS) {
    cornerTapL = cornerTapR = 0;
    openConfig();
  }
}

String configTimeString(uint16_t minutes) {
  if (settings.format_24h) return hhmm(minutes);
  int h = minutes / 60, h12 = h % 12 ? h % 12 : 12;
  return String(h12) + ":" + pad2(minutes % 60) + (h < 12 ? " AM" : " PM");
}

void drawButton(int x, int y, int w, int h, uint16_t bg, const char* text, uint16_t fg) {
  spr.fillRoundRect(x, y, w, h, 12, bg);
  if (text) {
    spr.setTextColor(fg, bg);
    spr.drawString(text, x + w / 2, y + h / 2);
  }
}

// +/- drawn as bars: the fonts are ASCII-only and a text '-' is too thin to aim at.
void drawStepButton(int x, int y, int w, int h, uint16_t bg, bool plus) {
  drawButton(x, y, w, h, bg, nullptr, 0);
  int cx = x + w / 2, cy = y + h / 2;
  spr.fillRect(cx - 16, cy - 4, 32, 8, TFT_WHITE);
  if (plus) spr.fillRect(cx - 4, cy - 16, 8, 32, TFT_WHITE);
}

void drawConfig(const ConfigRow* rows, int n) {
  const uint16_t BG     = rgb888to565(18, 18, 22);
  const uint16_t PANEL  = rgb888to565(58, 58, 66);
  const uint16_t ACCENT = rgb888to565(102, 204, 255);
  const uint16_t GREEN  = rgb888to565(40, 160, 90);

  spr.fillSprite(BG);
  spr.setTextDatum(MC_DATUM);
  useFont(fontText40);
  for (int t = 0; t < configPageCount(); t++) {
    bool active = t == configPage;
    drawButton(t * TAB_W + 6, 8, TAB_W - 12, HEADER_H - 16, active ? ACCENT : PANEL,
               configTabs[t], active ? TFT_BLACK : TFT_WHITE);
  }
  drawButton(4 * TAB_W + 6, 8, TAB_W - 12, HEADER_H - 16, GREEN, "Done", TFT_WHITE);

  for (int i = 0; i < n; i++) {
    const ConfigRow& r = rows[i];
    int cy = ROWS_Y + i * ROW_H + ROW_H / 2, top = cy - CTRL_H / 2;
    useFont(fontText40);
    spr.setTextDatum(ML_DATUM);
    spr.setTextColor(TFT_WHITE, BG);
    spr.drawString(r.label, 40, cy);
    spr.setTextDatum(MC_DATUM);

    if (r.kind == ROW_TOGGLE) {
      bool on = *(bool*)r.value;
      drawButton(600, top, 180, CTRL_H, on ? GREEN : PANEL, on ? "ON" : "OFF", TFT_WHITE);
    } else if (r.kind == ROW_ACTION) {
      drawButton(560, top, 220, CTRL_H, PANEL, "Play", TFT_WHITE);
    } else {
      String v = r.kind == ROW_PERCENT ? String(*(uint8_t*)r.value) + "%"
                                       : configTimeString(*(uint16_t*)r.value);
      drawStepButton(410, top, 90, CTRL_H, PANEL, false);
      drawStepButton(690, top, 90, CTRL_H, PANEL, true);
      if (spr.textWidth(v) > 180) useFont(fontText24);
      spr.setTextColor(TFT_WHITE, BG);
      spr.drawString(v, 595, cy);
    }
  }
  presentFrame();
}

// Percent in steps of 5; times in steps of 15 min, snapped to the quarter hour, wrapping at midnight.
void stepRow(const ConfigRow& r, int dir) {
  if (r.kind == ROW_PERCENT) {
    uint8_t* v = (uint8_t*)r.value;
    *v = constrain((int)*v + dir * 5, (int)r.min, (int)r.max);
    if (v == &settings.dim_level) dimPreviewUntil = (millis() + DIM_PREVIEW_MS) | 1;
  } else if (r.kind == ROW_TIME) {
    uint16_t* v = (uint16_t*)r.value;
    int m = dir > 0 ? (*v / 15 + 1) * 15 : ((*v + 14) / 15 - 1) * 15;
    *v = (m + 24 * 60) % (24 * 60);
  }
  configDirty = true;
}

void handleConfigTouch(const ConfigRow* rows, int n) {
  int x = touch.x, y = touch.y;
  if (y < HEADER_H) {
    int slot = x / TAB_W;
    if (slot == 4) { closeConfig(); return; }
    if (slot < configPageCount() && slot != configPage) { configPage = slot; configDirty = true; }
    return;
  }
  int i = (y - ROWS_Y) / ROW_H;
  if (y < ROWS_Y || i >= n) return;
  const ConfigRow& r = rows[i];
  if (r.kind == ROW_TOGGLE && x >= 560) {
    *(bool*)r.value = !*(bool*)r.value;
    configDirty = true;
  } else if (r.kind == ROW_ACTION && x >= 520) {
    startChime();
  } else if (r.kind == ROW_PERCENT || r.kind == ROW_TIME) {
    int dir = x >= 380 && x < 520 ? -1 : x >= 670 ? 1 : 0;
    if (!dir) return;
    stepRow(r, dir);
    heldRow = i; heldDir = dir;
    nextRepeat = millis() + REPEAT_DELAY_MS;
  }
}

// One loop pass while the settings are open.
void runConfig() {
  uint32_t now = millis();
  ConfigRow rows[4];
  int n = configRows(configPage, rows);

  if (touch.down) configLastTouch = now;
  if (!touch.down) heldRow = -1;
  if (touch.started) {
    heldRow = -1;
    handleConfigTouch(rows, n);
    if (!configOpen) return;
    n = configRows(configPage, rows);   // the page may have changed
  } else if (heldRow >= 0 && (int32_t)(now - nextRepeat) >= 0) {
    stepRow(rows[heldRow], heldDir);
    nextRepeat = now + REPEAT_MS;
  }
  if (now - configLastTouch >= CONFIG_IDLE_MS) { closeConfig(); return; }

  if (dimPreviewUntil && (int32_t)(now - dimPreviewUntil) >= 0) dimPreviewUntil = 0;
  setBacklightLevel(dimPreviewUntil ? min(settings.dim_level, settings.brightness)
                                    : settings.brightness, "settings");

  if (configDirty) {
    configDirty = false;
    drawConfig(rows, n);
  } else {
    delay(20);
  }
}

// ── Setup ───────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  Serial.printf("Board: %s\n", CrowPanel7::boardName());

  if (!display.begin()) {
    Serial.println("Display init failed — is OPI PSRAM enabled in the board options?");
    while (true) delay(1000);
  }
  bindSprite();
  loadFonts();
  spr.setTextDatum(MC_DATUM);

  loadSettings();
  buildGammaLut();
  restoreTimeFromRtc();

  Serial.printf("Display %dx%d, double-buffered, %.1f fps; free internal RAM %u KB, PSRAM %u KB\n",
                SCREEN_W, SCREEN_H, display.measureFps(),
                heap_caps_get_free_size(MALLOC_CAP_INTERNAL) / 1024,
                heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1024);
  logSettings("Loaded");

  // First frame is drawn into a framebuffer before the backlight comes on,
  // so the panel never shows uninitialized memory.
  showStatus("Color Clock", "Starting...", TFT_CYAN);
  backlightLevel = settings.brightness;
  display.setBrightness(backlightLevel);

  setupWiFi();
  applyTimeSettings();
  setupWebServer();
}

// ── Loop ────────────────────────────────────────────────────────────────────
void loop() {
  server.handleClient();
  checkWiFi();
  updateChime();
  pollTouch();

  if (testPatternUntil) {
    if ((int32_t)(millis() - testPatternUntil) < 0) { delay(50); return; }
    testPatternUntil = 0;
    lastS = -1;   // force a clock redraw
  }

  if (ntpSynced) {
    ntpSynced = false;
    if (display.writeRtc(time(nullptr))) Serial.println("RTC set from NTP");
  }

  if (configOpen) {
    runConfig();
    return;
  }

  struct tm ti;
  if (!getLocalTime(&ti, 10)) {
    delay(200);
    return;
  }

  bool tapWoke = updateScreenPower(ti);
  if (!tapWoke && backlightLevel == settings.brightness) checkCornerTaps();
  if (configOpen) return;
  checkHourlyChime(ti);

  int h = ti.tm_hour, m = ti.tm_min, s = ti.tm_sec;

  // Redraw if time changed OR settings changed
  bool settingsChanged = (settings.format_24h   != lastFmt24)
                      || (settings.show_seconds != lastSecs)
                      || (settings.show_date    != lastDate)
                      || (settings.gamma        != lastGamma)
                      || (wifiOnline            != lastOnline);
  if (h == lastH && m == lastM && s == lastS && !settingsChanged) {
    delay(chimeStep ? 5 : 50);   // step the chime on time
    return;
  }
  lastH = h; lastM = m; lastS = s;
  lastFmt24  = settings.format_24h;
  lastSecs   = settings.show_seconds;
  lastDate   = settings.show_date;
  lastGamma  = settings.gamma;
  lastOnline = wifiOnline;

  // ── Color from time ────────────────────────────────────────────────────
  uint8_t  R  = mapH(h);
  uint8_t  G  = mapM(m);
  uint8_t  B  = mapS(s);
  uint8_t  dR = gammaLut[R], dG = gammaLut[G], dB = gammaLut[B];   // as displayed
  uint16_t bg = rgb888to565(dR, dG, dB);
  uint16_t fg = bestTextColor(dR, dG, dB);

  spr.fillSprite(bg);
  spr.setTextColor(fg, bg);
  spr.setTextDatum(MC_DATUM);

  // ── Hex code ─────────────────────────────────────────────────────────
  char hexBuf[8];
  snprintf(hexBuf, sizeof(hexBuf), "#%02X%02X%02X", R, G, B);
  useFont(fontText56);
  spr.drawString(hexBuf, SCREEN_W/2, 50);

  // ── Time — digits pre-rendered at the size for this format, AM/PM beside ──
  String digits = formatTimeDigits(ti);
  const char* suffix = amPm(ti);
  SmoothFont& timeFont = !settings.show_seconds ? fontTimeL
                       : settings.format_24h    ? fontTimeM : fontTimeS;
  useFont(timeFont);
  int digitsW = spr.textWidth(digits);
  int digitsH = spr.fontHeight();
  int suffixW = 0;
  if (*suffix) {
    useFont(fontText56);
    suffixW = TIME_SUFFIX_GAP + spr.textWidth(suffix);
  }
  int timeX    = (SCREEN_W - digitsW - suffixW) / 2;
  int baseline = (settings.show_date ? 205 : 240) + digitsH / 2;
  spr.setTextDatum(L_BASELINE);
  useFont(timeFont);
  spr.drawString(digits, timeX, baseline);
  if (*suffix) {
    useFont(fontText56);
    spr.drawString(suffix, timeX + digitsW + TIME_SUFFIX_GAP, baseline);
  }
  spr.setTextDatum(MC_DATUM);

  // ── Date (optional) ──────────────────────────────────────────────────
  if (settings.show_date) {
    String dateStr = String(dayNames[ti.tm_wday]) + "  " +
                     pad2(ti.tm_mday) + " " +
                     monthNames[ti.tm_mon] + " " +
                     String(1900 + ti.tm_year);
    useFont(fontText56);
    spr.drawString(dateStr, SCREEN_W/2, 365);
  }

  // ── RGB strip ────────────────────────────────────────────────────────
  useFont(fontText24);
  char rgbBuf[28];
  snprintf(rgbBuf, sizeof(rgbBuf), "R:%3d   G:%3d   B:%3d", R, G, B);
  spr.drawString(rgbBuf, SCREEN_W/2, 450);

  if (!wifiOnline) {
    spr.setTextDatum(TR_DATUM);
    spr.drawString("No WiFi", SCREEN_W - 16, 12);
    spr.setTextDatum(MC_DATUM);
  }

  presentFrame();

  Serial.printf("%s  %s\n", formatTime(ti).c_str(), hexBuf);
}
