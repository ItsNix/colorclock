// ── Settings (persisted in NVS) ──────────────────────────────────────────────
struct Settings {
  String ntp_server;
  String tz_string;
  bool   format_24h;
  bool   show_seconds;
  bool   show_date;
  float  gamma;          // applied to the background color; 1.0 = off
  uint8_t  brightness;   // normal backlight, percent
  bool     dim_enabled;  // dim schedule
  uint16_t dim_start;    // minutes after midnight
  uint16_t dim_end;
  uint8_t  dim_level;    // backlight while dimmed, percent
  bool     off_enabled;  // screen-off schedule (wins where it overlaps dim)
  uint16_t off_start;
  uint16_t off_end;
  uint16_t wake_s;       // how long a tap brightens the screen when dim / off
  bool     chime;        // hourly beep (boards with a buzzer), quiet when dim / off
} settings;

void loadSettings() {
  prefs.begin("clock", true);
  settings.ntp_server   = prefs.getString("ntp",   DEFAULT_NTP);
  settings.tz_string    = prefs.getString("tz",    DEFAULT_TZ);
  settings.format_24h   = prefs.getBool  ("fmt24", true);
  settings.show_seconds = prefs.getBool  ("secs",  true);
  settings.show_date    = prefs.getBool  ("date",  true);
  settings.gamma        = prefs.getFloat ("gamma", DEFAULT_GAMMA);
  settings.brightness   = prefs.getUChar ("bright", 100);
  settings.dim_enabled  = prefs.getBool  ("dim",    false);
  settings.dim_start    = prefs.getUShort("dstart", 20 * 60);
  settings.dim_end      = prefs.getUShort("dend",   22 * 60);
  settings.dim_level    = prefs.getUChar ("dlevel", 30);
  // The off schedule falls back to the old single night-mode keys.
  settings.off_enabled  = prefs.getBool  ("off",    prefs.getBool  ("night",  false));
  settings.off_start    = prefs.getUShort("ostart", prefs.getUShort("nstart", 22 * 60));
  settings.off_end      = prefs.getUShort("oend",   prefs.getUShort("nend",   7 * 60));
  settings.wake_s       = prefs.getUShort("wake",   prefs.getUShort("nwake",  30));
  settings.chime        = prefs.getBool  ("chime",  false);
  prefs.end();
}

void saveSettings() {
  prefs.begin("clock", false);
  prefs.putString("ntp",   settings.ntp_server);
  prefs.putString("tz",    settings.tz_string);
  prefs.putBool  ("fmt24", settings.format_24h);
  prefs.putBool  ("secs",  settings.show_seconds);
  prefs.putBool  ("date",  settings.show_date);
  prefs.putFloat ("gamma", settings.gamma);
  prefs.putUChar ("bright", settings.brightness);
  prefs.putBool  ("dim",    settings.dim_enabled);
  prefs.putUShort("dstart", settings.dim_start);
  prefs.putUShort("dend",   settings.dim_end);
  prefs.putUChar ("dlevel", settings.dim_level);
  prefs.putBool  ("off",    settings.off_enabled);
  prefs.putUShort("ostart", settings.off_start);
  prefs.putUShort("oend",   settings.off_end);
  prefs.putUShort("wake",   settings.wake_s);
  prefs.putBool  ("chime",  settings.chime);
  prefs.end();
}

void logSettings(const char* what) {
  Serial.printf("%s: ntp=%s tz=%s 24h=%d secs=%d date=%d gamma=%.1f bright=%u%% "
                "dim=%d %s-%s at %u%% off=%d %s-%s wake=%us chime=%d\n", what,
                settings.ntp_server.c_str(), settings.tz_string.c_str(),
                settings.format_24h, settings.show_seconds, settings.show_date,
                settings.gamma, settings.brightness,
                settings.dim_enabled, hhmm(settings.dim_start).c_str(), hhmm(settings.dim_end).c_str(),
                settings.dim_level,
                settings.off_enabled, hhmm(settings.off_start).c_str(), hhmm(settings.off_end).c_str(),
                settings.wake_s, settings.chime);
}

// Set from the SNTP task on each sync; loop() copies the time into the RTC
// (I2C stays on the loop task, which also owns touch and backlight).
volatile bool ntpSynced = false;
bool wifiOnline = false;

// True once the clock has been set, by the RTC or NTP (anything after 2024-01-01).
bool timeKnown() { return time(nullptr) > 1704067200; }

void applyTimeSettings() {
  // ESP32 built-in SNTP — handles DST via POSIX TZ string
  configTzTime(settings.tz_string.c_str(), settings.ntp_server.c_str());
  sntp_set_time_sync_notification_cb([](struct timeval*) { ntpSynced = true; });
}

// Battery-backed RTC (Advance board only): sets the clock at boot, before NTP.
void restoreTimeFromRtc() {
  time_t utc;
  if (!display.readRtc(utc)) {
    Serial.println("RTC: none, or no valid time");
    return;
  }
  timeval tv = { utc, 0 };
  settimeofday(&tv, nullptr);
  Serial.printf("RTC: %s", asctime(gmtime(&utc)));   // UTC; asctime ends in '\n'
}

// ── Color mapping ─────────────────────────────────────────────────────────────
inline uint8_t mapH(int h) { return (uint8_t)((h * 255) / 23); }
inline uint8_t mapM(int m) { return (uint8_t)((m * 255) / 59); }
inline uint8_t mapS(int s) { return (uint8_t)((s * 255) / 59); }

// Background gamma correction: the CrowPanel's panel shows mid-tones much
// lighter than the T-Display's IPS, so darken them before display. The hex
// and R/G/B readouts still show the uncorrected time-mapped values.
uint8_t gammaLut[256];

void buildGammaLut() {
  for (int i = 0; i < 256; i++) {
    gammaLut[i] = (uint8_t)lroundf(powf(i / 255.0f, settings.gamma) * 255.0f);
  }
}

uint16_t rgb888to565(uint8_t r, uint8_t g, uint8_t b) {
  return ((uint16_t)(r & 0xF8) << 8) |
         ((uint16_t)(g & 0xFC) << 3) |
         ((uint16_t)(b >> 3));
}

// ── WCAG contrast / text color selection ─────────────────────────────────────
static uint16_t linearise(uint8_t c) {
  float cf  = c / 255.0f;
  float lin = (cf <= 0.04045f) ? (cf / 12.92f)
                                : powf((cf + 0.055f) / 1.055f, 2.4f);
  return (uint16_t)(lin * 1000.0f);
}

static uint32_t luminance1000(uint8_t r, uint8_t g, uint8_t b) {
  return (212UL * linearise(r) +
          715UL * linearise(g) +
           72UL * linearise(b)) / 1000UL;
}

static uint32_t contrastRatio100(uint32_t L1, uint32_t L2) {
  uint32_t hi = max(L1, L2) + 50;
  uint32_t lo = min(L1, L2) + 50;
  return (hi * 100UL) / lo;
}

uint16_t bestTextColor(uint8_t r, uint8_t g, uint8_t b) {
  uint32_t bgLum = luminance1000(r, g, b);
  struct Candidate { uint8_t r, g, b; uint16_t col565; };
  Candidate candidates[] = {
    {255, 255, 255, TFT_WHITE},
    {  0,   0,   0, TFT_BLACK},
    {180, 180, 180, rgb888to565(180, 180, 180)},
    { 80,  80,  80, rgb888to565( 80,  80,  80)},
  };

  uint32_t bestCR  = 0;
  uint16_t bestCol = TFT_WHITE;
  for (auto& c : candidates) {
    uint32_t lum = luminance1000(c.r, c.g, c.b);
    uint32_t cr  = contrastRatio100(bgLum, lum);
    if (cr > bestCR) { bestCR = cr; bestCol = c.col565; }
  }
  return bestCol;
}

// ── Calendar names (tm_wday: 0=Sun; tm_mon: 0=Jan) ──────────────────────────
const char* dayNames[]   = {"Sun","Mon","Tue","Wed","Thu","Fri","Sat"};
const char* monthNames[] = {"Jan","Feb","Mar","Apr","May","Jun",
                              "Jul","Aug","Sep","Oct","Nov","Dec"};

String pad2(int n) { return (n < 10 ? "0" : "") + String(n); }

// ── Format time string per settings ─────────────────────────────────────────
// Digits only ("13:05:09" or "1:05:09"); AM/PM comes from amPm().
String formatTimeDigits(const struct tm& ti) {
  String out;
  if (settings.format_24h) {
    out = pad2(ti.tm_hour);
  } else {
    int h12 = ti.tm_hour % 12; if (h12 == 0) h12 = 12;
    out = String(h12);
  }
  out += ":" + pad2(ti.tm_min);
  if (settings.show_seconds) out += ":" + pad2(ti.tm_sec);
  return out;
}

const char* amPm(const struct tm& ti) {
  if (settings.format_24h) return "";
  return ti.tm_hour < 12 ? "AM" : "PM";
}

String formatTime(const struct tm& ti) {
  String out = formatTimeDigits(ti);
  if (!settings.format_24h) out += String(" ") + amPm(ti);
  return out;
}

// "HH:MM" <-> minutes after midnight (for the schedule time inputs)
String hhmm(uint16_t minutes) { return pad2(minutes / 60) + ":" + pad2(minutes % 60); }

int parseHHMM(const String& s) {
  int colon = s.indexOf(':');
  if (colon < 1) return -1;
  int h = s.substring(0, colon).toInt(), m = s.substring(colon + 1).toInt();
  if (h < 0 || h > 23 || m < 0 || m > 59) return -1;
  return h * 60 + m;
}

